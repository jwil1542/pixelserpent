# Countdown before game starts (console)
def countdown():
    try:
        timeamount = input("How many seconds you want to time?:")
        timer = int(timeamount)
    except Exception:
        timer = 0
    while timer > 0:
        timer -= 1
        print(timer)
        pg.time.wait(1000)

# Load music (safe)
def try_play_music():
    try:
        pg.mixer.init(22050, -16, 2, 4096)
        pg.mixer.music.load(MUSIC_PATH)
        pg.mixer.music.play(20, 5.0)
    except Exception as e:
        # If music fails, just continue (no crash)
        print("Music load/play failed:", e)

# Helper to load the cookie font with a fallback
def load_font(size):
    try:
        return pg.font.Font(FONT_PATH, size)
    except Exception:
        return pg.font.SysFont("arial", size)

# -------------------------
# Collision helpers
# -------------------------
def collide(x1, y1, x2, y2, x3, y3, x4, y4):
    return ((x3 + x4) > x1 > x3 and (y3 + y4) > y1 > y3) or \
           ((x3 + x4) > x2 > x3 and (y3 + y4) > y2 > y3)

def collide2(x1, y1, x2, y2, x3, y3, x4, y4, size):
    return ((x3 + (11 * size)) > x1 > x3 - 1 and (y3 + (11 * size)) > y1 > y3 - 1) or \
           ((x3 + (11 * size)) > x2 > x3 - 1 and (y3 + (11 * size)) > y2 > y3 - 1)

def collide3(x1, y1, x2, y2, x3, y3, x4, y4, size):
    return ((x3 + (10 * size)) > x1 > x3 and (y3 + (10 * size)) > y1 > y3) or \
           ((x3 + (10 * size)) > x2 > x3 and (y3 + (10 * size)) > y2 > y3)

# -------------------------
# Snake & Apple classes
# -------------------------
class Snake:
    def __init__(self, speed, size):
        self.pos = [20, 20]
        self.size = size
        self.cell = 10 * size
        self.image = pg.Surface((self.cell, self.cell))
        self.image.fill((0, 255, 0))
        self.speed = speed
        self.direction = [0, 0]
        self.score = 0
        self.segments = []        # list of segment positions, head is self.pos
        self.max_segments = 0     # grows when eating

        # old positions buffer for smooth tail
        self.old_pos = []

    def set_dir_right(self): self.direction = [self.speed, 0]
    def set_dir_left(self):  self.direction = [-self.speed, 0]
    def set_dir_up(self):    self.direction = [0, -self.speed]
    def set_dir_down(self):  self.direction = [0, self.speed]

    def update(self):
        # store previous head pos
        self.old_pos.insert(0, [self.pos[0], self.pos[1]])
        # move head
        self.pos[0] += self.direction[0]
        self.pos[1] += self.direction[1]

        # update segments based on old_pos
        # each segment takes a spot that head previously occupied
        while len(self.old_pos) > max(1, (self.max_segments + 1) * (abs(int((11 * self.size) / max(1, int(self.speed))) ) + 1)):
            self.old_pos.pop()

        # rebuild segments list positions
        self.segments = []
        step = max(1, int((11 * self.size) // max(1, int(self.speed))))
        idx = step
        for i in range(self.max_segments):
            if idx - 1 < len(self.old_pos):
                self.segments.append([self.old_pos[idx - 1][0], self.old_pos[idx - 1][1]])
            else:
                # fallback position at head
                self.segments.append([self.pos[0], self.pos[1]])
            idx += step

    def add_apple(self):
        self.score += 1
        self.max_segments += 1

    def check_collisions(self, block_pos):
        return collide(self.pos[0], self.pos[1], self.pos[0] + self.cell, self.pos[1] + self.cell,
                       block_pos[0], block_pos[1], block_pos[0] + 10, block_pos[1] + 10)

    def check_apple(self, apple_pos):
        return collide2(self.pos[0], self.pos[1], self.pos[0] + self.cell, self.pos[1] + self.cell,
                        apple_pos[0], apple_pos[1], apple_pos[0] + 10, apple_pos[1] + 10, self.size)

    def check_self_collision(self):
        # check head against segments
        for seg in self.segments:
            if self.pos[0] == seg[0] and self.pos[1] == seg[1]:
                return True
        return False

class Apple:
    def __init__(self, size):
        self.size = size
        self.cell = 10 * size
        self.pos = [random.randrange(10, 780, 10), random.randrange(10, 430, 10)]
        self.image = pg.Surface((self.cell, self.cell))
        self.image.fill((255, 0, 0))

# -------------------------
# Game class
# -------------------------
class Game:
    def __init__(self, speed, size=1):
        self.screen = pg.display.set_mode(SCREEN_SIZE)
        pg.display.set_caption("Snake Game")
        self.clock = pg.time.Clock()
        self.snake = Snake(speed, size)
        self.size = size
        self.blocks = []
        self.left = self.right = self.up = self.down = False
        self.running = True

        # border blocks (10x10)
        color = (0, 0, 0)
        for x in range(0, 800, 10):
            s = pg.Surface((10, 10))
            s.fill(color)
            self.blocks.append([s, [x, 0]])
            s2 = pg.Surface((10, 10))
            s2.fill(color)
            self.blocks.append([s2, [x, 440]])
        for y in range(0, 450, 10):
            s = pg.Surface((10, 10))
            s.fill(color)
            self.blocks.append([s, [0, y]])
            s2 = pg.Surface((10, 10))
            s2.fill(color)
            self.blocks.append([s2, [790, y]])

        self.apple = Apple(size)
        # pre-create font objects
        self.font_title = load_font(80)
        self.font_button = load_font(24)
        self.font_game_over = load_font(50)

    def draw_border(self):
        for b in self.blocks:
            self.screen.blit(b[0], b[1])

    def draw_snake(self):
        # head
        self.screen.blit(self.snake.image, self.snake.pos)
        # segments
        for seg in self.snake.segments:
            surf = pg.Surface((self.snake.cell, self.snake.cell))
            surf.fill((0, 200, 0))
            self.screen.blit(surf, seg)

    def game_over_screen(self):
        # simple game over display with restart button
        while True:
            for event in pg.event.get():
                if event.type == pg.QUIT:
                    pg.quit(); sys.exit()
                if event.type == pg.KEYDOWN and event.key == pg.K_ESCAPE:
                    return  # back to menu

            self.screen.fill((35, 38, 117))
            self.draw_border()
            txt = self.font_game_over.render("Game Over    Score:", True, (255, 255, 255))
            self.screen.blit(txt, (20, 150))
            score_txt = self.font_game_over.render(str(self.snake.score), True, (255, 255, 255))
            self.screen.blit(score_txt, (600, 150))

            # Restart button
            btn_rect = pg.Rect((153, 300, 100, 50))
            mouse = pg.mouse.get_pos()
            clicked = pg.mouse.get_pressed()[0]
            color = (200, 200, 200) if btn_rect.collidepoint(mouse) else (255, 255, 255)
            pg.draw.rect(self.screen, color, btn_rect, border_radius=8)
            btn_txt = self.font_button.render("Restart", True, (0, 0, 0))
            self.screen.blit(btn_txt, btn_txt.get_rect(center=btn_rect.center))

            if btn_rect.collidepoint(mouse) and clicked:
                return  # exit game over to restart (menu will start a new game)

            pg.display.update()
            self.clock.tick(30)

    def loop(self):
        fps = max(5, int(10 / max(0.1, self.snake.speed)))  # rough fps related to speed
        while True:
            self.clock.tick(15)  # fixed tick for consistent input
            for event in pg.event.get():
                if event.type == pg.QUIT:
                    pg.quit(); sys.exit()
                elif event.type == pg.KEYDOWN:
                    if event.key == pg.K_RIGHT and not self.left:
                        self.reset_dirs(); self.snake.set_dir_right(); self.right = True
                    if event.key == pg.K_LEFT and not self.right:
                        self.reset_dirs(); self.snake.set_dir_left(); self.left = True
                    if event.key == pg.K_UP and not self.down:
                        self.reset_dirs(); self.snake.set_dir_up(); self.up = True
                    if event.key == pg.K_DOWN and not self.up:
                        self.reset_dirs(); self.snake.set_dir_down(); self.down = True

            # update
            self.snake.update()

            # collisions with border blocks
            for b in self.blocks:
                if self.snake.check_collisions(b[1]):
                    self.game_over_screen()
                    return  # return to menu

            # self collision
            if self.snake.check_self_collision():
                self.game_over_screen()
                return

            # eating apple
            if self.snake.check_apple(self.apple.pos):
                self.snake.add_apple()
                # reposition apple avoiding borders
                self.apple.pos = [random.randrange(10, 780, 10), random.randrange(10, 430, 10)]

            # draw
            self.screen.fill((35, 38, 117))
            self.draw_border()
            self.screen.blit(self.apple.image, self.apple.pos)
            self.draw_snake()

            # score display (small)
            score_surf = self.font_button.render(f"Score: {self.snake.score}", True, (255, 255, 255))
            self.screen.blit(score_surf, (10, 10))

            pg.display.update()

    def reset_dirs(self):
        self.left = self.right = self.up = self.down = False

# -------------------------
# Start Menu (no exec, safe buttons)
# -------------------------
class StartMenu:
    def __init__(self):
        self.screen = pg.display.set_mode(SCREEN_SIZE)
        pg.display.set_caption("Snake Game - Menu")
        self.clock = pg.time.Clock()
        self.buttons = []
        self.create_buttons()
        self.font_title = load_font(80)
        self.font_button = load_font(24)

    def create_buttons(self):
        # each button: rect, text, callback
        self.buttons = [
            (pg.Rect(150, 300, 100, 50), "Start", self.start_normal),
            (pg.Rect(550, 300, 100, 50), "Exit", self.exit_game)
        ]

    def start_normal(self):
        start_game(speed=0.5, size=1)

    def exit_game(self):
        pg.quit()
        sys.exit()

    def mainloop(self):
        while True:
            for event in pg.event.get():
                if event.type == pg.QUIT:
                    pg.quit(); sys.exit()

            self.screen.fill((35, 38, 117))

            # title
            title_surf = self.font_title.render("SNAKE GAME", True, (255, 255, 255))
            self.screen.blit(title_surf, title_surf.get_rect(center=(400, 150)))

            # draw border decoration
            color = (0,0,0)
            for x in range(0, 800, 10):
                t = pg.Surface((10,10))
                t.fill(color)
                self.screen.blit(t, (x,0))
                self.screen.blit(t, (x,440))
            for y in range(0,450,10):
                t = pg.Surface((10,10)); t.fill(color)
                self.screen.blit(t, (0,y))
                self.screen.blit(t, (790,y))

            # draw buttons and check clicks
            mouse = pg.mouse.get_pos()
            clicked = pg.mouse.get_pressed()[0]
            for rect, text, callback in self.buttons:
                highlight = (0, 200, 0) if rect.collidepoint(mouse) else (0,255,0)
                pg.draw.rect(self.screen, highlight, rect, border_radius=8)
                txt = self.font_button.render(text, True, (0,0,0))
                self.screen.blit(txt, txt.get_rect(center=rect.center))
                if rect.collidepoint(mouse) and clicked:
                    pg.time.wait(150)  # simple click debounce
                    callback()
                    return  # after starting, return to allow a new loop or exit

            pg.display.update()
            self.clock.tick(30)

# -------------------------
# High level control functions
# -------------------------
def start_game(speed=0.5, size=1):
    g = Game(speed, size)
    g.loop()

def menu():
    m = StartMenu()
    m.mainloop()

# -------------------------
# Run
# -------------------------
if __name__ == "__main__":
    countdown()        # optional console countdown
    try_play_music()   # attempt to play music (if available)
    menu()             # show menu
